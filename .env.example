# Copy to .env and fill in. Never commit .env.

# Browser app: Supabase dashboard > Project Settings > Data API (URL) and API Keys (publishable key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# scripts/sync-questions.mjs only. Supabase dashboard > Project Settings > API Keys > Secret keys.
# Store it in 1Password and put the secret reference here (1Password: item > field > Copy Secret Reference).
SUPABASE_SECRET_KEY=op://your-vault/your-item/credential
